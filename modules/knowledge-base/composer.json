    "type": "library",
    "version": "1.0.0",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "Moduloom\\KnowledgeBase\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moduloom\\KnowledgeBase\\KnowledgeBaseServiceProvider"
            ]
        }
    }
}
